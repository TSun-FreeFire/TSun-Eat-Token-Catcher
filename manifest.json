{
  "manifest_version": 3,
  "name": "TSun-Eat-Token-Catcher",
  "version": "2.2.0",
  "description": "Captures EAT token from Garena auth redirect.",
  "permissions": ["storage", "tabs", "activeTab", "notifications", "alarms", "downloads", "clipboardWrite", "scripting"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      }
    },
    "copy-token": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Copy the latest EAT token to clipboard"
    },
    "clear-token": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Clear the displayed token"
    }
  },
  "host_permissions": [
    "https://discstore.recargajogo.com.br/*",
    "https://auth.garena.com/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
