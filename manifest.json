{
  "manifest_version": 3,
  "name": "TSun-Eat-Token-Catcher",
  "version": "1.0.5",
  "description": "Captures EAT token from Garena auth redirect.",
  "permissions": ["storage", "tabs", "notifications", "alarms", "downloads"],
  "host_permissions": [
    "https://discstore.recargajogo.com.br/*",
    "https://auth.garena.com/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
